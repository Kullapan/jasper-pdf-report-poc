<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="claim_report" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35"
              summaryNewPage="true"
              uuid="7b3f1a20-9a10-4c9a-9f00-123456789abc">

    <style name="ThaiBase" default="true" fontName="Sarabun" fontSize="11.0" pdfFontName="Sarabun" pdfEncoding="Identity-H" pdfEmbedded="true"/>

    <parameter name="reportId" class="java.lang.String"/>
    <parameter name="claimNumber" class="java.lang.String"/>
    <parameter name="policyNumber" class="java.lang.String"/>
    <parameter name="claimantName" class="java.lang.String"/>
    <parameter name="incidentDate" class="java.lang.String"/>
    <parameter name="incidentDescription" class="java.lang.String"/>
    <parameter name="hospitalOrGarage" class="java.lang.String"/>
    <parameter name="version" class="java.lang.Integer"/>
    <parameter name="snapshotCreatedAt" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.lang.String"/>
    <parameter name="signerSubject" class="java.lang.String"/>
    <parameter name="claimantSignatureImage" class="java.lang.Object"/>
    <parameter name="approverSignatureImage" class="java.lang.Object"/>
    <parameter name="officialStampImage" class="java.lang.Object"/>

    <field name="itemNo" class="java.lang.Integer"/>
    <field name="description" class="java.lang.String"/>
    <field name="category" class="java.lang.String"/>
    <field name="amountFormatted" class="java.lang.String"/>

    <!-- PAGE 1: TITLE & CLAIMANT / POLICY OVERVIEW -->
    <title height="255" splitType="Stretch">
        <element kind="rectangle" uuid="11111111-1111-1111-1111-111111111101" x="0" y="0" width="515" height="60" backcolor="#1E293B">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" uuid="11111111-1111-1111-1111-111111111102" x="16" y="10" width="340" height="24" forecolor="#FFFFFF" fontName="Sarabun" fontSize="15.0" bold="true" vTextAlign="Middle">
            <text><![CDATA[รายงานการเรียกร้องค่าสินไหมทดแทน (ใบเคลมประกันภัย)]]></text>
        </element>
        <element kind="staticText" uuid="11111111-1111-1111-1111-111111111103" x="16" y="34" width="340" height="18" forecolor="#CBD5E1" fontName="Sarabun" fontSize="9.0" bold="false" vTextAlign="Middle">
            <text><![CDATA[OpenSource Insurance PoC — Digitally Signed Official Multi-Page Report (JasperReports 7.1.0)]]></text>
        </element>
        <element kind="textField" uuid="11111111-1111-1111-1111-111111111104" x="360" y="12" width="140" height="20" forecolor="#38BDF8" fontName="Sarabun" fontSize="12.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["ฉบับที่: v" + $P{version}]]></expression>
        </element>
        <element kind="textField" uuid="11111111-1111-1111-1111-111111111105" x="360" y="32" width="140" height="18" forecolor="#E2E8F0" fontName="Sarabun" fontSize="10.0" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["เลขที่เคลม: " + $P{claimNumber}]]></expression>
        </element>

        <element kind="rectangle" uuid="11111111-1111-1111-1111-111111111106" x="0" y="70" width="515" height="175" backcolor="#F8FAFC">
            <pen lineWidth="0.75" lineColor="#CBD5E1"/>
        </element>

        <element kind="staticText" uuid="11111111-1111-1111-1111-111111111120" x="14" y="76" width="486" height="20" forecolor="#0284C7" fontName="Sarabun" fontSize="11.0" bold="true" vTextAlign="Middle">
            <text><![CDATA[ส่วนที่ 1: ข้อมูลผู้เอาประกันภัยและรายละเอียดอุบัติเหตุ (Insured & Incident Details)]]></text>
        </element>

        <element kind="textField" uuid="11111111-1111-1111-1111-111111111107" x="14" y="100" width="240" height="20" fontName="Sarabun" fontSize="10.0" bold="true" vTextAlign="Middle">
            <expression><![CDATA["ชื่อผู้เอาประกันภัย: " + $P{claimantName}]]></expression>
        </element>
        <element kind="textField" uuid="11111111-1111-1111-1111-111111111108" x="265" y="100" width="235" height="20" fontName="Sarabun" fontSize="10.0" bold="true" vTextAlign="Middle">
            <expression><![CDATA["เลขที่กรมธรรม์: " + $P{policyNumber}]]></expression>
        </element>

        <element kind="textField" uuid="11111111-1111-1111-1111-111111111109" x="14" y="122" width="240" height="20" fontName="Sarabun" fontSize="10.0" vTextAlign="Middle">
            <expression><![CDATA["วันที่เกิดเหตุ: " + $P{incidentDate}]]></expression>
        </element>
        <element kind="textField" uuid="11111111-1111-1111-1111-111111111110" x="265" y="122" width="235" height="20" fontName="Sarabun" fontSize="10.0" vTextAlign="Middle">
            <expression><![CDATA["สถานพยาบาล / ศูนย์ซ่อม: " + $P{hospitalOrGarage}]]></expression>
        </element>

        <element kind="textField" uuid="11111111-1111-1111-1111-111111111111" x="14" y="146" width="486" height="60" fontName="Sarabun" fontSize="10.0" vTextAlign="Top">
            <expression><![CDATA["รายละเอียดเหตุการณ์: " + $P{incidentDescription} + "\nการตรวจสอบเบื้องต้น: ได้รับแจ้งเหตุถูกต้องตรงตามเงื่อนไขความคุ้มครองของสัญญาประกันภัย เอกสารหลักฐานประกอบการเรียกร้องค่าสินไหมครบถ้วนสมบูรณ์"]]></expression>
        </element>

        <element kind="textField" uuid="11111111-1111-1111-1111-111111111112" x="14" y="214" width="486" height="24" forecolor="#64748B" fontName="Sarabun" fontSize="8.0" vTextAlign="Middle">
            <expression><![CDATA["รหัสอ้างอิงเอกสาร (UUID): " + $P{reportId} + "  |  เวลาบันทึก Snapshot: " + $P{snapshotCreatedAt}]]></expression>
        </element>
    </title>

    <!-- PAGE 1: CLAIM ITEMS TABLE -->
    <columnHeader height="32" splitType="Stretch">
        <element kind="rectangle" uuid="22222222-2222-2222-2222-222222222201" x="0" y="0" width="515" height="28" backcolor="#E2E8F0">
            <pen lineWidth="0.5" lineColor="#94A3B8"/>
        </element>
        <element kind="staticText" uuid="22222222-2222-2222-2222-222222222202" x="8" y="4" width="42" height="20" fontName="Sarabun" fontSize="10.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[ลำดับ]]></text>
        </element>
        <element kind="staticText" uuid="22222222-2222-2222-2222-222222222203" x="56" y="4" width="234" height="20" fontName="Sarabun" fontSize="10.0" bold="true" vTextAlign="Middle">
